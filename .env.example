# Plan It / Student Spending Analytics configuration.
#
# Copy this file to /etc/plan-it/plan-it.env on the server, fill every value,
# then load it with systemd's EnvironmentFile=. Never commit the filled file.
# It contains operator details, not secrets: no API keys are required.
#
# Development ignores most of this file. Production (PLANIT_ENV=production)
# refuses to start until the required values below are supplied and
# PLANIT_LEGAL_REVIEWED=1.

# --- Runtime ---------------------------------------------------------------
PLANIT_ENV=production
# The public HTTPS address users type in the browser. Must be https://.
PLANIT_PUBLIC_URL=https://planit.example.com
# Bind loopback only; Caddy or nginx terminates TLS in front of this address.
PLANIT_HOST=127.0.0.1
# On by default in production. Refusing this is a startup error.
PLANIT_SECURE_COOKIES=1
# Set to 1 only when a reverse proxy you control overwrites X-Forwarded-For.
PLANIT_TRUST_PROXY=1

# --- Storage ---------------------------------------------------------------
# All directories must be writable by the service account and readable only
# by it. The systemd unit sets UMask=0077 and PrivateTmp=yes.
PLANIT_DATA_DIR=/var/lib/plan-it/data
PLANIT_WAREHOUSE_DIR=/var/lib/plan-it/warehouse
PLANIT_REPORTS_DIR=/var/lib/plan-it/reports
PLANIT_LOG_DIR=/var/log/plan-it
PLANIT_DB_PATH=/var/lib/plan-it/warehouse/student_spending.db
PLANIT_ACCOUNTS_DB=/var/lib/plan-it/data/accounts.db
# Optional overrides; the defaults follow PLANIT_DATA_DIR and PLANIT_WAREHOUSE_DIR.
# PLANIT_RAW_DATA_DIR=/var/lib/plan-it/data/raw
# PLANIT_PROCESSED_DATA_DIR=/var/lib/plan-it/data/processed
# PLANIT_UPLOAD_DATA_DIR=/var/lib/plan-it/data/uploads
# PLANIT_UPLOAD_WAREHOUSE_DIR=/var/lib/plan-it/warehouse/uploads
# PLANIT_UPLOAD_REPORT_DIR=/var/lib/plan-it/reports/uploads
# PLANIT_QUARANTINE_DIR=/var/lib/plan-it/data/quarantine
# PLANIT_SCHEMA=/opt/plan-it/src/student_spending/schema.sql

# --- Operator and legal pages ---------------------------------------------
# A qualified Kenyan lawyer must review the privacy notice and terms before
# launch. These values fill the [BRACKETED PLACEHOLDERS] in those pages.
PLANIT_OPERATOR_NAME="Example Operator Ltd"
PLANIT_OPERATOR_ADDRESS="12 Example Road, Nairobi, Kenya"
PLANIT_PRIVACY_EMAIL=privacy@example.com
PLANIT_ODPC_REGISTRATION="NOT YET REGISTERED"
PLANIT_ODPC_CONTACT="Office of the Data Protection Commissioner, Nairobi, Kenya (https://www.odpc.go.ke)"
PLANIT_EFFECTIVE_DATE=2026-12-01
PLANIT_HOSTING_PROVIDER="Example Hosting Ltd, Nairobi, Kenya"
PLANIT_INTERNATIONAL_TRANSFERS="None beyond the hosting provider named above."
PLANIT_RETENTION_PERIOD="30 days"
PLANIT_LOG_RETENTION="14 days"
PLANIT_BACKUP_RETENTION="30 days"
PLANIT_AGE_ASSURANCE="Users confirm that they are 18 or over when they create an account."
PLANIT_COUNTY=Nairobi
PLANIT_TRADEMARK="unregistered marks used by the operator of this service"
PLANIT_LIABILITY_CAP="To the extent permitted by Kenyan law, the operator's total liability is limited to KES 10,000 or the amount you paid in the previous 12 months, whichever is lower."
PLANIT_POLICY_VERSION=2026-11-07
# Set to 1 only after legal review. Until then every legal page shows a Draft banner.
PLANIT_LEGAL_REVIEWED=0
